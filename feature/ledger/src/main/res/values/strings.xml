    <string name="ledger_confirm">确定</string>
    <string name="ledger_cancel">取消</string>

    <!-- 删除：物理删除不可恢复（ADR-0005），所以对话框必须把后果说清楚 -->
    <string name="ledger_delete">删除</string>
    <string name="ledger_delete_title">删除这条记录？</string>
    <string name="ledger_delete_message">删除后无法恢复。</string>
    <string name="ledger_entry_deleted">已删除，这条记录不在账本里了。</string>

    <!-- 编辑（REQ-003）：身份与录入时间不变，所以文案说的是"修改这条"，不是"另存一条" -->
    <string name="ledger_edit">编辑</string>
    <string name="ledger_editing">正在修改这条记录</string>
    <string name="ledger_save_edit">保存修改</string>
    <string name="ledger_edit_cancel">取消编辑</string>
    <string name="ledger_error_entry_not_found">这条记录已经不在了（可能已被删除）</string>

    <string name="ledger_error_amount_empty">请输入金额</string>
    <string name="ledger_error_amount_not_a_number">金额只能是数字</string>
    <string name="ledger_error_amount_too_many_decimals">金额最多两位小数</string>
    <string name="ledger_error_amount_not_positive">金额必须大于 0</string>
    <string name="ledger_error_category_required">请选择分类</string>
    <string name="ledger_error_note_too_long">备注最多 200 个字</string>
    <string name="ledger_error_storage">保存失败：本机数据库出错，这笔没有记上</string>
    <!-- REQ-006/AC-2：读失败与写失败必须分开说，否则用户会去排查错方向 -->
    <string name="ledger_error_load_failed">账目暂时读不出来：本机数据库出错</string>
    <!-- REQ-006/AC-3：跳过坏数据必须伴随告知，不能让它看起来像"账目变少了" -->
    <string name="ledger_unreadable_entries">有 %1$d 条记录读不出来（数据可能被外部改坏），已跳过；它们仍计入合计。</string>
    <!-- REQ-007 分类下钻：标题必须说清"哪个分类、哪个月"，否则用户不知道自己在看什么 -->
    <string name="ledger_category_entries_title">%1$s · %2$s</string>
    <string name="ledger_category_entries_empty">这个月这一类没有支出</string>
    <string name="ledger_category_entries_failed">这些记录暂时读不出来：本机数据库出错</string>
    <string name="ledger_category_entries_close">关闭</string>
    <string name="ledger_error_rejected">这条记录没有被接受，请检查填写内容</string>

    <!-- 分类管理（REQ-004）：入口在记账页顶部 -->
    <string name="ledger_categories">分类</string>
