# 统一换行：仓库内一律 LF，检出时按平台转换
* text=auto eol=lf

# 文档与源码
*.md    text eol=lf
*.kt    text eol=lf
*.kts   text eol=lf
*.java  text eol=lf
*.xml   text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.pro   text eol=lf

# Windows 专用脚本保留 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制：不转换、不 diff
*.jar   binary
*.jks   binary
*.keystore binary
*.png   binary
*.jpg   binary
*.webp  binary
*.ttf   binary
*.otf   binary
*.so    binary
*.aab   binary
*.apk   binary

# 生成物与归档不参与统计
*.lock      linguist-generated=true
gradle/wrapper/gradle-wrapper.jar binary
